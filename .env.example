# Server Configuration
PORT=3000
NODE_ENV=production
SESSION_SECRET=bookhub_secure_production_secret_key_change_me

# Persistent Cloud Database (Recommended for Vercel Serverless Deployment)
# Sign up free at https://turso.tech and run:
#   turso db create bookhub
#   turso db show bookhub --url  -> paste into TURSO_DATABASE_URL
#   turso db tokens create bookhub -> paste into TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://bookhub-your-username.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
