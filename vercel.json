{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "includeFiles": "public/**,frontend/**,database/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/server"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/server"
    }
  ]
}
